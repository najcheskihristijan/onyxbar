---
const sections = [
  { src: "/home/1.jpg", alt: "O" },
  { src: "/home/2.jpg", alt: "N" },
  { src: "/home/3.jpg", alt: "Y" },
  { src: "/home/4.jpg", alt: "X" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Onyx Bar</title>
    <meta name="description" content="Onyx Bar." />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body>
    <div class="track" id="track">
      {sections.map((s, i) => (
        <section class="letter" data-i={i}>
          <img src={s.src} alt={s.alt} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
        </section>
      ))}
    </div>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        height: 100%;
        overflow: hidden;
        background: #0a0a0a;
      }
      body {
        color: #ffffff;
        font-family: Georgia, "Times New Roman", serif;
      }
      .track {
        display: flex;
        width: 100vw;
        height: 100vh;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
      }
      .track::-webkit-scrollbar { display: none; }
      .letter {
        position: relative;
        flex: 0 0 100vw;
        height: 100vh;
        scroll-snap-align: start;
        background: #0a0a0a;
        overflow: hidden;
      }
      .letter img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        user-select: none;
        -webkit-user-drag: none;
        backface-visibility: hidden;
        will-change: filter;
      }
    </style>

    <script>
      const track = document.getElementById('track') as HTMLDivElement;
      const sections = Array.from(document.querySelectorAll<HTMLElement>('.letter'));
      let ticking = false;

      function update() {
        const vw = window.innerWidth;
        const center = track.scrollLeft + vw / 2;
        for (const section of sections) {
          const sCenter = section.offsetLeft + section.offsetWidth / 2;
          const d = Math.abs(sCenter - center) / vw;
          // 1 at perfectly centered, 0 once half a viewport away
          const t = Math.max(0, 1 - d * 2);
          const active = Math.pow(t, 1.6);
          // Faded during transit (low saturation + dim), vivid at rest.
          const sat = (0.35 + 0.65 * active).toFixed(3);
          const bri = (0.65 + 0.35 * active).toFixed(3);
          const img = section.querySelector<HTMLImageElement>('img');
          if (img) img.style.filter = `saturate(${sat}) brightness(${bri})`;
        }
        ticking = false;
      }

      function request() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      track.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);

      // Vertical wheel → horizontal scroll for mouse users.
      track.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          track.scrollBy({ left: e.deltaY, behavior: 'auto' });
        }
      }, { passive: false });

      requestAnimationFrame(update);
      window.addEventListener('load', update);
    </script>
  </body>
</html>
